# Server configuration — all optional in development (defaults shown).
# Copy to .env for local overrides; .env files are gitignored, never commit them.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=*
# Default targets the local supabase stack's Postgres (well-known local dev
# credentials, not a secret). Production (Railway) injects its own URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Optional — leave unset to run the AI service in deterministic fake mode
# (local dev + E2E). With a key set, brain dump parsing uses Gemini.
# GEMINI_API_KEY=
# JWT verification (Story 5.2) — defaults target the local supabase stack.
# Verification is JWKS-only (ES256); there is deliberately no JWT-secret env.
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
# Ops logging (Story 8.3): debug|info|warn|error. debug is dev/test only —
# boot fails fast on NODE_ENV=production with LOG_LEVEL=debug.
LOG_LEVEL=info
# Server-side analytics (Story 8.3). Leave the key unset for a no-op stub —
# a real key is a drop-in with zero code changes.
# POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
